# the SDV nonsecure KeyMint, as on the SDV core VM; without the label keystore2 and vold wait forever
/vendor/bin/hw/android\.sdv\.hardware\.security\.keymint-service\.nonsecure  u:object_r:hal_keymint_rust_exec:s0

/vendor/bin/net_bringup\.sh      u:object_r:net_bringup_exec:s0
/vendor/bin/dhcpclient           u:object_r:dhcpclient_exec:s0
/vendor/bin/everyware-browser\.sh u:object_r:everyware_browser_exec:s0

# The card's partitions (fstab.rpi5, tools/mkimg.sh); the by-name links point at these nodes
/dev/block/mmcblk0p1             u:object_r:boot_block_device:s0
/dev/block/mmcblk0p3             u:object_r:userdata_block_device:s0
/dev/block/mmcblk0p5             u:object_r:super_block_device:s0
/dev/block/mmcblk0p6             u:object_r:metadata_block_device:s0
/dev/block/mmcblk0p7             u:object_r:misc_block_device:s0

# v3d (card0, renderD128) and vc4 (card1), as the reference port labels them; HAR's
# vendor_harplatform may use gpu_device
/dev/dri(/.*)?                   u:object_r:gpu_device:s0

# Mesa and the vendor libraries it links, loaded into every process that uses EGL
/vendor/lib(64)?/libgallium_dri\.so   u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libdrm\.so           u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libexpat\.so         u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libhardware\.so      u:object_r:same_process_hal_file:s0
