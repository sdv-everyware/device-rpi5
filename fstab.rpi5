# The card (tools/mkimg.sh): p1 boot (FAT, read by the board's firmware), p5 super, p6 metadata,
# p7 misc (the boot HAL's slot state), p3 userdata. MBR partitions have no names; the kernel
# command line names them (androidboot.partition_map in BoardConfig.mk). Encryption as on the
# RB3; without inline crypto hardware the kernel's fallback encrypts.
#<src>                         <mnt_point>   <type>  <mnt_flags and options>                                <fs_mgr_flags>
system                         /system       erofs   ro                                                     wait,logical,first_stage_mount,slotselect
vendor                         /vendor       erofs   ro                                                     wait,logical,first_stage_mount,slotselect
system_ext                     /system_ext   erofs   ro                                                     wait,logical,first_stage_mount,slotselect
product                        /product      erofs   ro                                                     wait,logical,first_stage_mount,slotselect
/dev/block/by-name/metadata    /metadata     ext4    noatime,nosuid,nodev,discard                           wait,formattable,first_stage_mount,check
/dev/block/by-name/userdata    /data         f2fs    nodev,noatime,nosuid,inlinecrypt,reserve_root=32768    latemount,wait,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,quota,check,fscompress
/dev/block/by-name/misc        /misc         emmc    defaults                                               defaults
